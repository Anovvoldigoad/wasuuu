<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-android34.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>NSC_ModManager_Android</RootNamespace>
    <AssemblyName>NSCModManagerAndroid</AssemblyName>
    <ApplicationId>com.nscmodmanager.android</ApplicationId>
    <ApplicationTitle>NSC Mod Manager Android</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidSupportedAbis>arm64-v8a</AndroidSupportedAbis>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <AndroidNativeLibrary Include="native-libs\arm64-v8a\libcpkbridge.so" Condition="Exists('native-libs\arm64-v8a\libcpkbridge.so')" Link="lib\arm64-v8a\libcpkbridge.so" />
  </ItemGroup>
</Project>
